# Token publico de Mapbox para el mapa de la sede.
#
# Se hornea en el HTML durante el build: NO es un secreto, es un token publico
# (prefijo pk.). Si esta variable falta cuando corre `npm run build`, el sitio
# sale con el mapa en blanco y el mensaje "falta PUBLIC_MAPBOX_TOKEN".
#
# En el host de produccion hay que declararla como variable de ENTORNO del
# build, no como runtime: Astro reemplaza import.meta.env.PUBLIC_* durante la
# compilacion, asi que si se agrega despues de construir no tiene efecto.
#
# En https://account.mapbox.com/access-tokens/ el token debe tener el dominio de
# produccion en "URL restrictions". Con el token restringido a localhost, Mapbox
# responde 401 en el sitio publicado y el mapa no carga.
PUBLIC_MAPBOX_TOKEN=