---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  titulo: string;
  antes: ImageMetadata;
  despues: ImageMetadata;
  antesAlt: string;
  despuesAlt: string;
}

const { titulo, antes, despues, antesAlt, despuesAlt } = Astro.props;

/* El aria-label del range lo lee un lector de pantalla, asi que tambien va
   traducido. */
const lang = Astro.currentLocale ?? 'es';
const etiqueta = lang === 'en' ? 'Compare before and after' : 'Comparar antes y después';
---

<article class="cmp" data-reveal>
  <div class="cmp__marco" data-cmp>
    <Picture
      class="cmp__capa"
      src={antes}
      alt={antesAlt}
      widths={[360, 380, 760]}
      sizes="(min-width: 64rem) 23rem, 100vw"
      loading="lazy"
      decoding="async"
    />

    <div class="cmp__despues">
      <Picture
        class="cmp__capa"
        src={despues}
        alt={despuesAlt}
        widths={[360, 380, 760]}
        sizes="(min-width: 64rem) 23rem, 100vw"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="cmp__linea" aria-hidden="true">
      <span class="cmp__pomo">
        <Icon name="arrow-left-01" size={11} />
        <Icon name="arrow-right-01" size={11} />
      </span>
    </div>

    <input
      class="cmp__input"
      type="range"
      min="0"
      max="100"
      value="50"
      step="1"
      aria-label={`${etiqueta}: ${titulo}`}
    />
  </div>
</article>

<style>
  .cmp {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--slate-100);
    border-radius: var(--r-card);
    background: #fff;
    box-shadow: 0 1px 2px oklch(0.225 0.039 266 / 0.04);
  }

  .cmp__marco {
    position: relative;
    overflow: hidden;
    aspect-ratio: 2 / 1;
    background: var(--slate-100);
    /* El input gestiona su propio arrastre; pan-y deja pasar el scroll
       vertical de la pagina si el gesto del usuario es vertical. */
    touch-action: pan-y;
  }

  .cmp__capa {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cmp__capa :global(picture),
  .cmp__capa :global(img) {
    width: 100%;
    height: 100%;
  }

  .cmp__capa :global(img) {
    object-fit: cover;
  }

  /* La capa de despues se revela a la derecha de la linea. inset(top right
     bottom left) recorta el lado izquierdo hasta --pos. */
  .cmp__despues {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: inset(0 0 0 var(--pos, 50%));
  }

  .cmp__linea {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos, 50%);
    z-index: 3;
    width: 2px;
    margin-left: -1px;
    background: #fff;
    box-shadow: 0 0 0 1px oklch(0.225 0.039 266 / 0.12);
    pointer-events: none;
  }

  .cmp__pomo {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1px;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--r-pill);
    background: #fff;
    color: var(--slate-600);
    transform: translate(-50%, -50%);
    box-shadow: 0 2px 8px oklch(0.225 0.039 266 / 0.18);
    transition: transform var(--dur-base) var(--ease-out);
  }

  /* El input nativo cubre toda la imagen: arrastrar en cualquier punto mueve la
     linea, y el teclado funciona sin codigo extra. opacity 0 lo esconde pero
     lo deja focusable y con su semantica de slider. */
  .cmp__input {
    position: absolute;
    inset: 0;
    z-index: 4;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    appearance: none;
    background: transparent;
  }

  .cmp__input::-webkit-slider-thumb {
    appearance: none;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: var(--r-pill);
  }

  .cmp__input::-moz-range-thumb {
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: var(--r-pill);
  }

  /* Foco visible en el pomo: el input es invisible, asi que el anillo se
     dibuja ahi para que se vea donde estas escribiendo con el teclado. */
  .cmp__marco:has(.cmp__input:focus-visible) .cmp__pomo {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
  }

  .cmp__marco:active .cmp__pomo {
    transform: translate(-50%, -50%) scale(1.1);
  }

  @media (hover: hover) and (pointer: fine) {
    .cmp:hover {
      box-shadow: 0 8px 24px oklch(0.225 0.039 266 / 0.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cmp__pomo {
      transition: none;
    }
  }
</style>

<script>
  /* Unica pieza de JS del sitio. Sin framework ni hidratacion: solo mueve una
     variable CSS cuando el input cambia. */
  const selectores = '[data-cmp]';

  function conectar(marco: HTMLElement) {
    const input = marco.querySelector<HTMLInputElement>('.cmp__input');
    if (!input) return;

    const pintar = () => marco.style.setProperty('--pos', `${input.value}%`);
    input.addEventListener('input', pintar);
    pintar();
  }

  document.querySelectorAll<HTMLElement>(selectores).forEach(conectar);
</script>
