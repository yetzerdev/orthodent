---
import LayoutSEO from '../layouts/LayoutSEO.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';

export interface Props {
  title: string;
  description: string;
  actualizado: string;
}

const { title, description, actualizado } = Astro.props;

const lang = Astro.currentLocale ?? 'es';
const inicio = lang === 'en' ? '/en' : '/';
const cta = lang === 'en'
  ? { label: 'Book a visit', href: '/en#agendar' }
  : { label: 'Agendar cita', href: '/#agendar' };
---

<LayoutSEO title={title} description={description} lang={lang}>
  <Header cta={cta} />

  <main class="legal shell" id="contenido">
    <header class="legal__cabecera">
      <p class="legal__miga">
        <a href={inicio}>
          <Icon name="arrow-left-01" size={14} />
          {lang === 'en' ? 'Back to home' : 'Volver al inicio'}
        </a>
      </p>
      <h1>{title}</h1>
      <p class="legal__actualizado">
        {lang === 'en' ? 'Last updated' : 'Actualizado'}: {actualizado}
      </p>
    </header>

    <div class="legal__cuerpo">
      <slot />
    </div>
  </main>

  <Footer />
  <CookieBanner />
</LayoutSEO>

<style>
  .legal {
    padding-block: clamp(2rem, 4vw, 3.5rem) var(--section-y);
  }

  .legal__cabecera {
    max-width: 46rem;
    margin-bottom: 2.5rem;
  }

  .legal__miga {
    color: var(--brand-strong);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  /* El enlace de vuelta al inicio es lo unico accionable antes de leer nada
     largo, asi que se lee como boton y no como una linea de texto mas. */
  .legal__miga a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem 0.375rem 0.5rem;
    border: 1px solid var(--slate-200);
    border-radius: var(--r-full);
    color: var(--slate-600);
    font-weight: 600;
    text-decoration: none;
    transition:
      color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }

  .legal__miga a:hover {
    border-color: var(--brand);
    background: color-mix(in oklch, var(--brand) 6%, transparent);
    color: var(--brand-strong);
  }

  .legal__cabecera h1 {
    margin-top: 0.5rem;
    color: var(--ink);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .legal__actualizado {
    margin-top: 0.625rem;
    color: var(--slate-500);
    font-size: 0.8125rem;
  }

  /* Una sola columna con medida corta: el texto legal sin ancho corto es
     ilegible, y las listas a dos columnas rompen la lectura. */
  .legal__cuerpo {
    display: grid;
    gap: 1.75rem;
    max-width: var(--measure);
  }

  .legal__cuerpo :global(h2) {
    color: var(--ink);
    font-size: 1.125rem;
    line-height: 1.3;
  }

  .legal__cuerpo :global(h2:not(:first-child)) {
    margin-top: 1rem;
  }

  .legal__cuerpo :global(p),
  .legal__cuerpo :global(li) {
    color: var(--slate-600);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .legal__cuerpo :global(ul),
  .legal__cuerpo :global(ol) {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.25rem;
  }

  .legal__cuerpo :global(ul) {
    list-style: disc;
  }

  .legal__cuerpo :global(ol) {
    list-style: decimal;
  }

  .legal__cuerpo :global(a) {
    color: var(--brand-strong);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal__cuerpo :global(strong) {
    color: var(--ink);
    font-weight: 700;
  }

  /* Caja de datos de contacto: sin borde propio, solo un bloque de texto
     que se distingue por el titulo. */
  .legal__cuerpo :global(dl) {
    display: grid;
    gap: 0.375rem;
  }

  .legal__cuerpo :global(dt) {
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .legal__cuerpo :global(dd) {
    margin: 0;
    color: var(--slate-600);
    font-size: 0.9375rem;
  }
</style>